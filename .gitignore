# ═══════════════════════════════════════════════════════════════════════════
#  TraceVIC — single .gitignore for the whole repository
# ═══════════════════════════════════════════════════════════════════════════

# ── Datasets and generated graph data ──────────────────────────────────────
# graph_construction/data/ is distributed via OSF: https://osf.io/qfkjm
# Everything else below is regenerated locally — see the READMEs.
graph_construction/data/
graph_construction/joern_output/
graph_construction/repositories/
graph_construction/workspace/
graph_construction/tmp_szz/
training_pipeline/temporal_graph/
training_pipeline/temporal_graph_gen/

# ── Bear compilation databases (generated by bear_compilation/*.py) ────────
graph_construction/bear_compilation/compile_commands_*.json
graph_construction/bear_compilation/build_logs/

# ── Locally installed tools ────────────────────────────────────────────────
# GumTree is built from source; Joern is installed separately; libclang via conda.
graph_construction/mapping/gumtree/
joern/
joern-cli/
libclang/

# ── Joern runtime output (generated per run) ───────────────────────────────
graph_construction/mapping/joern_targets.txt
graph_construction/mapping/workspace/

# ── Training outputs ───────────────────────────────────────────────────────
checkpoints_*/
runs/
*.pt
*.pth

# ── Baseline outputs not distributed ───────────────────────────────────────
baselines/neuralszz/checkpoints_*/
baselines/neuralszz/results_*/
baselines/neuralszz/logs/
baselines/neuralszz/tmp_szz/
baselines/SZZ/logs/
baselines/SZZ/tmp_szz/
baselines/SZZ/results/log/
baselines/SZZ/data/archive_old_dataset/

# ── Diagnostics (not part of the released pipeline) ────────────────────────
training_pipeline/analysis/

# ── Logs and archives ──────────────────────────────────────────────────────
*.log
logs/
logs_*/
*.zip
*.tar.gz
*.tar.bz2

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.ruff_cache/
.pytest_cache/
*.egg-info/
venv/
.venv/

# ── Editor / OS ────────────────────────────────────────────────────────────
.DS_Store
._*
__MACOSX/
.idea/
.vscode/
